# Perpl socket relay (relay/server.mjs). Local default: ws://localhost:8787
NEXT_PUBLIC_PERPL_WS_RELAY=ws://localhost:8787
# true = Perpl testnet (Monad testnet 10143). Default: Monad mainnet (143).
NEXT_PUBLIC_PERPL_TESTNET=false
# Monad RPC used for balance reads and receipts.
NEXT_PUBLIC_MONAD_RPC=https://rpc.monad.xyz
NEXT_PUBLIC_GAME_API=http://localhost:8787
